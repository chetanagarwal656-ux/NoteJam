'''n=int(input("enter the value of n: "))
for i in range(1,n+1):
    print(" "*(n-i)+"*"*(2*i-1))
for i in range(n,0,-1):
    print(" "*(n-i)+"*"*(2*i-1))'''

      # method 2

n=int(input("enter the value of n: "))
for i in range(1,2*n+1):
    if i<=n:
        print(" "*(n-i)+"*"*(2*i-1))
    else:
        j=2*n+1-i
        print(" "*(n-j)+"*"*(2*j-1))

